# 빌드서버 설정 — scripts/server.env 로 복사해 값을 채운다(server.env 는 .gitignore 로 막혀 있다).
# 접속 정보 파일: SSH_SERVER · SSH_USER_ID · SSH_USER_PWD 를 KEY=VALUE 로 담은 파일
SSH_ENV_FILE=../MpowerClassify/.env_vllm
# 빌드서버에서 소스를 풀고 빌드할 폴더
DP_BUILD_DIR=/path/to/docparse_build
# 빌드서버의 cargo 가 있는 폴더
CARGO_BIN_DIR=/path/to/.cargo/bin
